# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : mister-puzzle
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Endpoint d’ingestion d’erreurs
VITE_ERROR_INGEST_URL=

# Firebase API key
VITE_FIREBASE_API_KEY=

# Firebase app id
VITE_FIREBASE_APP_ID=

# Firebase auth domain
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=

# Firebase messaging sender
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase project id
VITE_FIREBASE_PROJECT_ID=

# Firebase storage bucket
VITE_FIREBASE_STORAGE_BUCKET=

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# Cache-bust icônes PWA
VITE_PWA_ICON_QS=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Environnement Sentry
VITE_SENTRY_ENVIRONMENT=
