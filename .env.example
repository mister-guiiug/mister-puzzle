# Firebase
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://0445a1e0a5fcc5319a0584a960c48e06@o4511240922005504.ingest.de.sentry.io/4511242741809232
VITE_SENTRY_ENVIRONMENT=production

# Mesure d'audience — clé de projet PostHog, nuage EUROPÉEN. La MÊME pour tout
# le parc : un seul projet, les applications distinguées dedans par `app_name`,
# que le socle déduit du chemin de base. Publique par conception.
VITE_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXX

# Erreurs — URL facultative d'ingestion : `src/utils/reportError.ts` y POSTe
# chaque erreur d'exécution en JSON (`keepalive`). Vide : rien n'est envoyé,
# la console structurée reste seule.
VITE_ERROR_INGEST_URL=

# Build
VITE_BASE_PATH=/mister-puzzle/
# VITE_PWA_ICON_QS n'est PAS à poser : `vite.config.ts` le définit au build
# (`define`), un suffixe de requête qui force le rafraîchissement du logo.
NODE_ENV=production
