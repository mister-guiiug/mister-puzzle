{
  "name": "mister-puzzle",
  "description": "PWA collaborative : progression puzzle en direct, photos, checkpoints, graphique, export PNG, thème clair/sombre, FR/EN.",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "build:analyze": "cross-env ANALYZE=1 npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only database --project demo-mister-puzzle \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc -b"
  },
  "bundleBudget": {
    "_pourquoi": "Relevé de 320 à 340 le 06/09/2026 : `firebase/auth` (connexion anonyme, VALEUR.md V3) ajoute 24,6 kB gzip dans un chunk asynchrone, et le budget compte TOUT le JS émis, pas seulement le chemin critique. Mesuré : 291,8 kB avant, 319,7 kB après — 0,3 kB de marge sous 320, soit une CI rouge à la prochaine montée de dépendance. 340 rend la marge qu'il y avait (≈ 28 kB).",
    "totalGzipKb": 340
  },
  "dependencies": {
    "@sentry/react": "^8.45.0",
    "@tailwindcss/vite": "^4.3.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "web-vitals": "^4.2.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@mister-guiiug/dev-pwa-config": "^4.4.1",
    "@playwright/test": "^1.49.1",
    "@sentry/vite-plugin": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.8.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
